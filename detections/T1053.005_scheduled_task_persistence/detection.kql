// T1053.005 - Scheduled Task Persistence via schtasks.exe
// Table: DeviceProcessEvents

let lookback = 30d;
let AllowedParents = dynamic(["msiexec.exe", "googleupdate.exe", "tiworker.exe"]);
let UserWritable = dynamic([@"\appdata\", @"\users\public\", @"\downloads\", @"\temp\", @"\programdata\"]);
let SuspiciousTasks = dynamic([
    "powershell", "pwsh", "cmd.exe", "wscript", "cscript",
    "regsvr32", "rundll32", "mshta", "bitsadmin", "certutil", "http://", "https://"
]);

DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName =~ "schtasks.exe"
| where ProcessCommandLine has_any ("/create", "-create")
| where not(InitiatingProcessFileName in~ (AllowedParents))
| extend
    FromUserWritable      = tolower(InitiatingProcessFolderPath) has_any (UserWritable),
    CallsSuspiciousBinary = tolower(ProcessCommandLine) has_any (SuspiciousTasks),
    UnsignedParent        = isempty(InitiatingProcessSignerType) or InitiatingProcessSignerType == "None"
| extend RiskScore = 40
    + iff(FromUserWritable, 30, 0)
    + iff(CallsSuspiciousBinary, 40, 0)
    + iff(UnsignedParent, 20, 0)
| extend Severity = case(RiskScore >= 90, "High", RiskScore >= 60, "Medium", "Low")
| project Timestamp, Severity, RiskScore, DeviceName, Account = AccountName,
          Actor = InitiatingProcessFileName, ActorPath = InitiatingProcessFolderPath,
          CommandLine = ProcessCommandLine
| order by RiskScore desc, Timestamp desc
