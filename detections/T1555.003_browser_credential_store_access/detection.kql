// T1555.003 - Browser Credential Store Copied Out of Profile Directory
// Table: DeviceFileEvents

let lookback = 30d;
let sweepWindow = 5m;
let AllowedCopiers = dynamic([]);
let ProfileDirs = dynamic([@"\user data\", @"\mozilla\firefox\profiles\", @"\opera software\", @"\vivaldi\"]);
let BrowserPaths = dynamic([
    @"\program files\google\chrome\", @"\program files (x86)\google\chrome\",
    @"\program files\microsoft\edge\", @"\program files (x86)\microsoft\edge\",
    @"\program files\mozilla firefox\", @"\program files\bravesoftware\", @"\program files (x86)\bravesoftware\"
]);
let BrowserNames = dynamic(["chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "vivaldi.exe"]);
let MasterKeyFiles = dynamic(["local state", "key4.db", "key3.db"]);
let ChromiumFiles = dynamic(["login data", "login data for account", "web data", "local state"]);
let GeckoFiles = dynamic(["logins.json", "key4.db", "key3.db", "cookies.sqlite", "signons.sqlite"]);
let UserWritable = dynamic([@"\appdata\", @"\users\public\", @"\downloads\", @"\temp\", @"\programdata\"]);

DeviceFileEvents
| where Timestamp > ago(lookback)
| where ActionType in ("FileCreated", "FileModified", "FileRenamed")
| extend Store = tolower(FileName)
| where Store in (ChromiumFiles) or Store in (GeckoFiles)
| where not(tolower(FolderPath) has_any (ProfileDirs))
| where not(tolower(InitiatingProcessFileName) in (AllowedCopiers))
| summarize
    FirstSeen      = min(Timestamp),
    StoresTaken    = make_set(Store, 20),
    DistinctStores = dcount(Store),
    LandedIn       = make_set(FolderPath, 10),
    CopierPath     = any(InitiatingProcessFolderPath),
    CopierSigner   = any(InitiatingProcessVersionInfoCompanyName),
    Account        = any(InitiatingProcessAccountName)
  by DeviceId, DeviceName, Copier = InitiatingProcessFileName, bin(Timestamp, sweepWindow)
| extend
    TakesMasterKey    = array_length(set_intersect(StoresTaken, MasterKeyFiles)) > 0,
    MultiVendor       = array_length(set_intersect(StoresTaken, ChromiumFiles)) > 0 and array_length(set_intersect(StoresTaken, GeckoFiles)) > 0,
    LandedInTemp      = tolower(tostring(LandedIn)) has_any (UserWritable),
    CopierInTemp      = tolower(CopierPath) has_any (UserWritable),
    CopierUnsigned    = isempty(CopierSigner),
    CopierMasquerades = tolower(Copier) in (BrowserNames) and not(tolower(CopierPath) has_any (BrowserPaths))
| extend RiskScore = 35
    + iff(TakesMasterKey, 30, 0)
    + iff(DistinctStores >= 3, 25, 0)
    + iff(CopierInTemp, 25, 0)
    + iff(MultiVendor, 20, 0)
    + iff(CopierUnsigned, 20, 0)
    + iff(LandedInTemp, 15, 0)
    + iff(CopierMasquerades, 30, 0)
| extend Severity = case(RiskScore >= 95, "High", RiskScore >= 60, "Medium", "Low")
| project Timestamp = FirstSeen, Severity, RiskScore, DeviceName, Account,
          Copier, CopierPath, DistinctStores, StoresTaken
| order by RiskScore desc, Timestamp desc
