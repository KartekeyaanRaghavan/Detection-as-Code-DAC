// =====================================================================================
// BASELINE: run this before deploying, to find what RMM already exists in the estate
//
// Deploying this rule without knowing your own footprint produces an unusable alert
// volume on day one. Establish the baseline, allow list it explicitly, then deploy.
// =====================================================================================
//
// DeviceProcessEvents
// | where Timestamp > ago(30d)
// | where tolower(FileName) in (RmmBinaries)
// | summarize Executions = count(), Devices = dcount(DeviceId),
//             Paths = make_set(FolderPath, 15), Signers = make_set(ProcessVersionInfoCompanyName, 10)
//     by FileName
// | order by Devices desc
