// T1656 - External Teams Contact to a User Who Was Just Mail-Bombed
// Tables: EmailEvents, CloudAppEvents

let lookback = 30d;
let BombWindow = 1h;
let CorrelationWindow = 8h;
let BombThreshold = 40;
let DistinctSenderDomains = 15;
let TrustedSupportTenants = dynamic([]);
let SupportPersona = dynamic([
    "help desk", "helpdesk", "it support", "it desk", "service desk",
    "support team", "technical support", "security team", "it team", "microsoft support"
]);

let mailBombs = EmailEvents
| where Timestamp > ago(lookback) and EmailDirection == "Inbound"
| summarize MailCount = count(), SenderDomains = dcount(SenderFromDomain),
            BombStart = min(Timestamp), BombEnd = max(Timestamp)
  by RecipientEmailAddress, bin(Timestamp, BombWindow)
| where MailCount >= BombThreshold and SenderDomains >= DistinctSenderDomains;

let externalChats = CloudAppEvents
| where Timestamp > ago(lookback) and Application has "Teams"
| where ActionType in ("ChatCreated", "MessageSent", "MemberAdded")
| extend Raw = parse_json(RawEventData)
| where tostring(Raw.CommunicationType) =~ "ExternalFederated"
| extend
    SenderUpn     = tostring(Raw.SenderUPN),
    SenderDisplay = tolower(tostring(Raw.SenderDisplayName)),
    RecipientEmailAddress = tolower(tostring(Raw.ParticipantInfo.ParticipatingSIPs))
| extend SenderDomain = tolower(tostring(split(SenderUpn, "@")[1]))
| where not(SenderDomain in (TrustedSupportTenants))
| project ChatTime = Timestamp, SenderUpn, SenderDomain, SenderDisplay, RecipientEmailAddress;

mailBombs
| join kind=inner externalChats on RecipientEmailAddress
| where ChatTime between (BombStart .. (BombEnd + CorrelationWindow))
| extend
    ImpersonatesSupport = SenderDisplay has_any (SupportPersona),
    MinutesAfterBomb    = datetime_diff('minute', ChatTime, BombEnd)
| extend RiskScore = 60
    + iff(ImpersonatesSupport, 30, 0)
    + iff(MinutesAfterBomb <= 60, 20, 0)
    + iff(MailCount >= 150, 10, 0)
| extend Severity = case(RiskScore >= 90, "High", RiskScore >= 60, "Medium", "Low")
| project Severity, RiskScore, Victim = RecipientEmailAddress, MailCount, SenderDomains,
          ChatTime, MinutesAfterBomb, ExternalSender = SenderUpn, SenderDisplayName = SenderDisplay
| order by RiskScore desc, ChatTime desc
