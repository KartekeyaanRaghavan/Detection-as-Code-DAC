//           InitiatingProcessFileName


// =====================================================================================
// BASELINE: what does normal external Teams traffic look like in your tenant
//
// Run before deploying. If your tenant federates widely, raise BombThreshold rather than
// loosening the correlation window, because the window is the precision.
// =====================================================================================
//
// CloudAppEvents
// | where Timestamp > ago(30d)
// | where Application has "Teams"
// | extend Raw = parse_json(RawEventData)
// | where tostring(Raw.CommunicationType) =~ "ExternalFederated"
// | summarize Chats = count(), Recipients = dcount(tostring(Raw.SenderUPN))
//     by SenderDomain = tolower(tostring(split(tostring(Raw.SenderUPN), "@")[1]))
// | order by Chats desc
