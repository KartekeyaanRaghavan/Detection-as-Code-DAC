// External Teams contact to a user who was just mail bombed
// Platform : Microsoft Defender XDR - Advanced Hunting
// Tables   : EmailEvents, CloudAppEvents
// ATT&CK   : T1656 (Impersonation), T1585.002, leading to T1219
// Author   : Kartekeyaan Raghavan
//
// TUNE: TrustedSupportTenants must list any federated tenant that legitimately provides your
// users with support, or every genuine MSP contact will fire.

let lookback              = 30d;
let BombWindow            = 1h;     // window over which the mail flood is counted
let CorrelationWindow     = 8h;     // how long after the flood the Teams contact still correlates
let BombThreshold         = 40;     // inbound mails from distinct senders inside BombWindow
let DistinctSenderDomains = 15;     // the flood comes from many unrelated services
let TrustedSupportTenants = dynamic([]);   // TUNE e.g. ["msp.example.com"]
let SupportPersona        = dynamic([
    "help desk", "helpdesk", "it support", "it desk", "service desk",
    "support team", "technical support", "security team", "it team",
    "microsoft support", "office 365 support"
]);
//
// --- stage 1: mailbox flooding ---------------------------------------------------------
let mailBombs =
    EmailEvents
    | where Timestamp > ago(lookback)
    | where EmailDirection == "Inbound"
    | summarize
        MailCount     = count(),
        SenderDomains = dcount(SenderFromDomain),
        SampleSenders = make_set(SenderFromDomain, 12),
        BombStart     = min(Timestamp),
        BombEnd       = max(Timestamp)
      by RecipientEmailAddress, bin(Timestamp, BombWindow)
    | where MailCount >= BombThreshold and SenderDomains >= DistinctSenderDomains
    | project RecipientEmailAddress, BombStart, BombEnd, MailCount, SenderDomains, SampleSenders;
//
// --- stage 2: external Teams contact ----------------------------------------------------
let externalChats =
    CloudAppEvents
    | where Timestamp > ago(lookback)
    | where Application has "Teams"
    | where ActionType in ("ChatCreated", "MessageSent", "MemberAdded")
    | extend Raw = parse_json(RawEventData)
    | extend
        CommunicationType = tostring(Raw.CommunicationType),
        SenderUpn         = tostring(Raw.SenderUPN),
        SenderDisplay     = tolower(tostring(Raw.SenderDisplayName)),
        RecipientUpn      = tostring(Raw.ParticipantInfo.ParticipatingSIPs)
    | where CommunicationType =~ "ExternalFederated"
    | extend SenderDomain = tolower(tostring(split(SenderUpn, "@")[1]))
    | where not(SenderDomain in (TrustedSupportTenants))
    | project ChatTime = Timestamp, SenderUpn, SenderDomain, SenderDisplay,
              RecipientEmailAddress = tolower(RecipientUpn), ChatAction = ActionType, ReportId;
//
// --- correlate --------------------------------------------------------------------------
mailBombs
| join kind=inner externalChats on RecipientEmailAddress
| where ChatTime between (BombStart .. (BombEnd + CorrelationWindow))
| extend
    ImpersonatesSupport = SenderDisplay has_any (SupportPersona),
    MinutesAfterBomb    = datetime_diff('minute', ChatTime, BombEnd)
| extend RiskScore =
        60                                                    // the correlation itself
      + iff(ImpersonatesSupport, 30, 0)
      + iff(MinutesAfterBomb <= 60, 20, 0)                  // arrives while the user is still flooded
      + iff(MailCount >= 150, 10, 0)
| extend Severity = case(RiskScore >= 90, "High", RiskScore >= 60, "Medium", "Low")
| project
    Severity, RiskScore,
    Victim            = RecipientEmailAddress,
    BombStart, BombEnd, MailCount, SenderDomains, SampleSenders,
    ChatTime, MinutesAfterBomb,
    ExternalSender    = SenderUpn,
    SenderTenant      = SenderDomain,
    SenderDisplayName = SenderDisplay,
    ImpersonatesSupport,
    ReportId
| order by RiskScore desc, ChatTime desc


// =====================================================================================
// FOLLOW ON: did the victim then run remote access software
//
// This is the payload of the whole sequence. A hit here escalates the incident from
// attempted social engineering to a live hands on keyboard intrusion. Cross reference
// with the T1219 detection in this repository.
// =====================================================================================
