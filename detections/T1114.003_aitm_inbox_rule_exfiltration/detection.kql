// T1114.003 - Mailbox Rule Created to Forward or Hide Mail After Compromise
// Table: CloudAppEvents (Exchange Online audit records in RawEventData JSON)

let lookback = 30d;
let AcceptedDomains = dynamic(["contoso.com", "contoso.onmicrosoft.com"]);
let SuppressionFolders = dynamic([
    "RSS Feeds", "RSS Subscriptions", "Conversation History",
    "Deleted Items", "Junk Email", "Archive", "Notes", "Sync Issues"
]);
let HighRiskKeywords = dynamic([
    "invoice", "payment", "remittance", "wire", "bank", "swift", "iban",
    "purchase order", "vendor", "supplier", "password", "verify", "mfa", "otp"
]);

CloudAppEvents
| where Timestamp > ago(lookback)
| where ActionType in ("New-InboxRule", "Set-InboxRule", "UpdateInboxRules")
| extend Raw = parse_json(RawEventData)
| extend Params = Raw.Parameters
| extend
    RuleName      = tostring(Params.Name),
    ForwardTarget = tolower(strcat(tostring(Params.ForwardTo), " ", tostring(Params.ForwardAsAttachmentTo), " ", tostring(Params.RedirectTo))),
    MoveToFolder  = tostring(Params.MoveToFolder),
    DeleteMessage = tostring(Params.DeleteMessage),
    MarkAsRead    = tostring(Params.MarkAsRead),
    KeywordBlob   = tolower(strcat(tostring(Params.SubjectContainsWords), " ", tostring(Params.BodyContainsWords), " ", tostring(Params.SubjectOrBodyContainsWords)))
| extend
    ForwardsExternally      = isnotempty(trim(" ", ForwardTarget)) and not(ForwardTarget has_any (AcceptedDomains)),
    SuppressesMail          = MoveToFolder in~ (SuppressionFolders) or DeleteMessage =~ "True",
    TargetsHighRiskKeywords = KeywordBlob has_any (HighRiskKeywords)
| where ForwardsExternally or SuppressesMail
| extend RiskScore =
      iff(ForwardsExternally, 50, 0)
    + iff(SuppressesMail, 30, 0)
    + iff(TargetsHighRiskKeywords, 20, 0)
    + iff(MarkAsRead =~ "True", 10, 0)
    + iff(isempty(trim(" ", RuleName)) or RuleName in (".", "..", "-", "_"), 15, 0)
| extend Severity = case(RiskScore >= 80, "High", RiskScore >= 50, "Medium", "Low")
| project Timestamp, Severity, RiskScore, Actor = AccountDisplayName, IPAddress,
          RuleName, ForwardTarget, MoveToFolder, DeleteMessage, KeywordBlob
| order by RiskScore desc, Timestamp desc
