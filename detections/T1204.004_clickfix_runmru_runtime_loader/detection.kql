// ClickFix: command pasted into Run dialog, and the signed-runtime loader that follows
// Platform : Microsoft Defender XDR - Advanced Hunting
// ATT&CK   : T1204.004 (Malicious Copy and Paste), T1059.001, T1105, T1543.003
// Author   : Kartekeyaan Raghavan
//
// Three queries. Run A for coverage, B for the second stage, C to confirm the chain.

// =====================================================================================
// A. RunMRU write containing an interpreter, downloader or obfuscation token
//    This is the highest-fidelity single indicator of ClickFix. Deploy this one.
// =====================================================================================
let lookback = 30d;
let Interpreters = dynamic([
    "powershell", "pwsh", "cmd /c", "cmd.exe /c", "mshta", "wscript",
    "cscript", "rundll32", "regsvr32", "msiexec", "conhost", "forfiles"
]);
let Downloaders = dynamic([
    "curl ", "certutil", "bitsadmin", "invoke-webrequest", "iwr ", "wget ",
    "downloadstring", "downloadfile", "http://", "https://"
]);
let Obfuscation = dynamic([
    "-enc", "-encodedcommand", "frombase64string", "iex", "invoke-expression",
    "-w hidden", "-windowstyle hidden", "-executionpolicy bypass", "-nop", "-noprofile"
]);
DeviceRegistryEvents
| where Timestamp > ago(lookback)
| where ActionType == "RegistryValueSet"
| where RegistryKey has @"\Explorer\RunMRU"
| extend TypedCommand = tostring(RegistryValueData)
| extend cmd = tolower(TypedCommand)
| extend
    HasInterpreter  = cmd has_any (Interpreters),
    HasDownloader   = cmd has_any (Downloaders),
    HasObfuscation  = cmd has_any (Obfuscation)
| where HasInterpreter or HasDownloader or HasObfuscation
| extend RiskScore =
        (iff(HasInterpreter, 40, 0))
      + (iff(HasDownloader, 30, 0))
      + (iff(HasObfuscation, 40, 0))
      + (iff(HasInterpreter and HasDownloader, 20, 0))    // interpreter + remote fetch = the ClickFix shape
      + (iff(strlen(TypedCommand) > 120, 20, 0))          // pasted, not typed
      + (iff(cmd matches regex @"[a-z0-9+/]{80,}={0,2}", 30, 0))  // embedded base64 blob
| extend Severity = case(RiskScore >= 90, "High", RiskScore >= 50, "Medium", "Low")
| project
    Timestamp, Severity, RiskScore, DeviceName,
    Account = InitiatingProcessAccountUpn,
    TypedCommand,
    CommandLength = strlen(TypedCommand),
    HasInterpreter, HasDownloader, HasObfuscation,
    ReportId, DeviceId
| order by RiskScore desc, Timestamp desc


// =====================================================================================
// B. Signed script runtime executed as an in-memory loader from a user-writable path
//
//    Second stage. Operators increasingly drop a legitimate, signed runtime (deno, bun,
//    node, python) rather than a custom binary, because the runtime is trusted, has a
//    valid signature, and executes attacker script entirely in memory. The runtime is
//    not malware; its parentage and location are what make it suspicious.
// =====================================================================================
