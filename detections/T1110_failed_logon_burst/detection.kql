// T1110 - Failed Logon Burst Followed by Success
// Table: DeviceLogonEvents

let lookback = 30d;
let BurstThreshold = 5;
let BurstWindow = 15m;

let FailedLogons = DeviceLogonEvents
| where Timestamp > ago(lookback) and ActionType == "LogonFailed"
| where isnotempty(AccountName) and isnotempty(RemoteIP)
| summarize FailedCount = count(), FirstFailed = min(Timestamp), LastFailed = max(Timestamp)
  by AccountName, RemoteIP, DeviceName, bin(Timestamp, BurstWindow)
| where FailedCount >= BurstThreshold;

let SuccessfulLogons = DeviceLogonEvents
| where Timestamp > ago(lookback) and ActionType == "LogonSuccess"
| where isnotempty(AccountName) and isnotempty(RemoteIP)
| summarize SuccessTime = min(Timestamp) by AccountName, RemoteIP, DeviceName;

FailedLogons
| join kind=inner SuccessfulLogons on AccountName, RemoteIP, DeviceName
| where SuccessTime between (FirstFailed .. (LastFailed + BurstWindow))
| extend RiskScore = 50
    + iff(FailedCount >= 10, 20, 0)
    + iff(FailedCount >= 20, 20, 0)
| extend Severity = case(RiskScore >= 90, "High", RiskScore >= 60, "Medium", "Low")
| project Timestamp = SuccessTime, Severity, RiskScore, Account = AccountName,
          RemoteIP, DeviceName, FailedCount, FirstFailed, LastFailed, SuccessTime
| order by RiskScore desc, Timestamp desc
